# OpenTofu / Terraform generated files
.terraform/
# .terraform.lock.hcl IS committed (reproducible provider versions)
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*
*.tfplan

# Output of the local-only learning levels
**/out/

# Sensitive var files — never commit
*.auto.tfvars
secrets.tfvars
*secrets*

# Custom provider build output
custom-provider/terraform-provider-*
custom-provider/bin/

# Go build artifacts
custom-provider/*.exe
# go.sum IS committed

# Editor / OS
.DS_Store
.idea/
*.swp
*.swo
.terraform/
*.tfvars

# Throwaway override files (e.g. offline-plan backend swap)
override.tf
